foreach(EYERELAX_REQUIRED_VARIABLE IN ITEMS
        EYERELAX_PROJECT_ROOT
        EYERELAX_DESKTOP_EXECUTABLE
        EYERELAX_DESKTOP_ICON
        EYERELAX_DESKTOP_OUTPUT)
    if(NOT DEFINED ${EYERELAX_REQUIRED_VARIABLE} OR
       "${${EYERELAX_REQUIRED_VARIABLE}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${EYERELAX_REQUIRED_VARIABLE}")
    endif()
endforeach()

configure_file(
    "${EYERELAX_PROJECT_ROOT}/resources/linux/EyesRelax.desktop.in"
    "${EYERELAX_DESKTOP_OUTPUT}"
    @ONLY
)
