get_filename_component(EYERELAX_PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(EYERELAX_THIRD_PARTY_DIR "${EYERELAX_PROJECT_ROOT}/third_party")
set(EYERELAX_WX_SOURCE_DIR "${EYERELAX_THIRD_PARTY_DIR}/wxWidgets")
set(EYERELAX_WX_STAGING_DIR "${EYERELAX_THIRD_PARTY_DIR}/wxWidgets.extracting")

file(MAKE_DIRECTORY "${EYERELAX_THIRD_PARTY_DIR}")
file(LOCK "${EYERELAX_THIRD_PARTY_DIR}/.wxwidgets-extract.lock"
     GUARD PROCESS TIMEOUT 300)

if(EXISTS "${EYERELAX_WX_SOURCE_DIR}/CMakeLists.txt")
    message(STATUS "Using wxWidgets source at ${EYERELAX_WX_SOURCE_DIR}")
    return()
endif()

file(GLOB EYERELAX_WX_ARCHIVES LIST_DIRECTORIES false
     "${EYERELAX_THIRD_PARTY_DIR}/wxWidgets*.zip")
list(LENGTH EYERELAX_WX_ARCHIVES EYERELAX_WX_ARCHIVE_COUNT)
if(NOT EYERELAX_WX_ARCHIVE_COUNT EQUAL 1)
    message(FATAL_ERROR
        "Expected exactly one third_party/wxWidgets*.zip archive, found "
        "${EYERELAX_WX_ARCHIVE_COUNT}")
endif()
list(GET EYERELAX_WX_ARCHIVES 0 EYERELAX_WX_ARCHIVE)

# Only these two fixed, project-local directories may contain an interrupted
# extraction from an earlier run.
file(REMOVE_RECURSE "${EYERELAX_WX_STAGING_DIR}")
if(EXISTS "${EYERELAX_WX_SOURCE_DIR}")
    file(REMOVE_RECURSE "${EYERELAX_WX_SOURCE_DIR}")
endif()
file(MAKE_DIRECTORY "${EYERELAX_WX_STAGING_DIR}")

message(STATUS "Extracting ${EYERELAX_WX_ARCHIVE}")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E tar xf "${EYERELAX_WX_ARCHIVE}"
    WORKING_DIRECTORY "${EYERELAX_WX_STAGING_DIR}"
    RESULT_VARIABLE EYERELAX_WX_EXTRACT_RESULT
)
if(NOT EYERELAX_WX_EXTRACT_RESULT EQUAL 0)
    file(REMOVE_RECURSE "${EYERELAX_WX_STAGING_DIR}")
    message(FATAL_ERROR "Failed to extract ${EYERELAX_WX_ARCHIVE}")
endif()

set(EYERELAX_WX_EXTRACTED_ROOT "")
if(EXISTS "${EYERELAX_WX_STAGING_DIR}/CMakeLists.txt")
    set(EYERELAX_WX_EXTRACTED_ROOT "${EYERELAX_WX_STAGING_DIR}")
else()
    file(GLOB EYERELAX_WX_TOP_LEVEL LIST_DIRECTORIES true
         "${EYERELAX_WX_STAGING_DIR}/*")
    foreach(EYERELAX_WX_CANDIDATE IN LISTS EYERELAX_WX_TOP_LEVEL)
        if(IS_DIRECTORY "${EYERELAX_WX_CANDIDATE}" AND
           EXISTS "${EYERELAX_WX_CANDIDATE}/CMakeLists.txt")
            list(APPEND EYERELAX_WX_ROOT_CANDIDATES "${EYERELAX_WX_CANDIDATE}")
        endif()
    endforeach()
    list(LENGTH EYERELAX_WX_ROOT_CANDIDATES EYERELAX_WX_ROOT_COUNT)
    if(EYERELAX_WX_ROOT_COUNT EQUAL 1)
        list(GET EYERELAX_WX_ROOT_CANDIDATES 0 EYERELAX_WX_EXTRACTED_ROOT)
    endif()
endif()

if(NOT EYERELAX_WX_EXTRACTED_ROOT)
    file(REMOVE_RECURSE "${EYERELAX_WX_STAGING_DIR}")
    message(FATAL_ERROR "The wxWidgets archive does not contain a CMakeLists.txt")
endif()

file(RENAME "${EYERELAX_WX_EXTRACTED_ROOT}" "${EYERELAX_WX_SOURCE_DIR}")
if(EXISTS "${EYERELAX_WX_STAGING_DIR}")
    file(REMOVE_RECURSE "${EYERELAX_WX_STAGING_DIR}")
endif()
message(STATUS "wxWidgets source prepared at ${EYERELAX_WX_SOURCE_DIR}")
